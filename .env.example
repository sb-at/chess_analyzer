# Database
DATABASE_URL=postgresql://chessmirror:chessmirror_dev@localhost:5432/chessmirror
MONGODB_URL=mongodb://localhost:27017/chessmirror

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Chess.com OAuth
CHESS_COM_CLIENT_ID=your-chess-com-client-id
CHESS_COM_CLIENT_SECRET=your-chess-com-client-secret
CHESS_COM_REDIRECT_URI=http://localhost:3000/auth/chess-com/callback

# Lichess OAuth
LICHESS_CLIENT_ID=your-lichess-client-id
LICHESS_REDIRECT_URI=http://localhost:3000/auth/lichess/callback

# Stockfish
STOCKFISH_PATH=/usr/games/stockfish

# API
API_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
